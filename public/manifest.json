{
	"name": "gta-leetcode-extension",
	"description": "A leetcode extension that displays mission passed & failed banners on submissions",
	"version": "1.0.0",
	"manifest_version": 3,
	"action": {
		"default_icon": {
			"16": "assets/logo-16.jpg",
			"24": "assets/logo-24.jpg",
			"32": "assets/logo-32.jpg"
		},
		"default_title": "gta_extension_popup",
		"default_popup": "popup.html"
	},
	"icons": {
		"16": "assets/logo-16.jpg",
		"48": "assets/logo-48.jpg",
		"128": "assets/logo-128.jpg"
	},
	"permissions": ["webRequest", "scripting", "activeTab"],
	"host_permissions": ["https://leetcode.com/*"],
	"background": {
		"service_worker": "background.js"
	},
	"content_scripts": [
		{
			"matches": ["https://leetcode.com/*"],
			"js": ["content.js"],
			"run_at": "document_idle"
		}
	],
	"web_accessible_resources": [
		{
			"resources": ["banners/*"],
			"matches": ["<all_urls>"]
		},
		{
			"resources": ["sounds/*"],
			"matches": ["<all_urls>"]
		},
		{
			"resources": ["assets/*"],
			"matches": ["<all_urls>"]
		}
	]
}
